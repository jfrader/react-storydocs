{
  "name": "@jfrader/storybook-docs",
  "version": "0.13.0",
  "type": "module",
  "description": "A documentation front for any design system that has Storybook: navigation, live examples and API tables are generated from the story files themselves.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite-plugin.d.ts",
      "import": "./dist/vite-plugin.js"
    }
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.0.0 || ^7.0.0 || ^8.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.4"
  },
  "packageManager": "pnpm@10.12.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "marked": "^18.1.1",
    "react-docgen-typescript": "^2.4.0",
    "typescript": "^5.9.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jfrader/storybook-docs.git"
  },
  "homepage": "https://github.com/jfrader/storybook-docs",
  "bugs": {
    "url": "https://github.com/jfrader/storybook-docs/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "keywords": [
    "storybook",
    "react",
    "vite",
    "design-system",
    "documentation",
    "props",
    "docs"
  ],
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "pnpm build:package && pnpm --dir examples/jfrader-ui build",
    "build:package": "node scripts/build.mjs",
    "smoke:package": "node scripts/smoke-package.mjs",
    "check:frames": "node scripts/check-example-frames.mjs",
    "prepack": "pnpm build:package"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist",
    "docs/CONFIG.md",
    "docs/RELEASING.md",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ]
}
