{
  "name": "@jfrader/storybook-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A documentation front for any design system that has Storybook: navigation, live examples and API tables are generated from the story files themselves.",
  "exports": {
    ".": "./src/index.ts",
    "./vite": "./src/vite-plugin.ts"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.0.0 || ^7.0.0 || ^8.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  },
  "packageManager": "pnpm@10.12.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "marked": "^18.1.1",
    "react-docgen-typescript": "^2.4.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jfrader/storybook-docs.git"
  },
  "homepage": "https://github.com/jfrader/storybook-docs",
  "keywords": [
    "storybook",
    "design-system",
    "documentation",
    "props",
    "docs"
  ],
  "scripts": {
    "test": "node --test test/*.test.ts"
  },
  "engines": {
    "node": ">=22"
  }
}
